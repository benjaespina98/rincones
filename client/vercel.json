{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rincones-api.vercel.app/api/:path*"
    },
    {
      "source": "/((?!assets/|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.svg|manifest.webmanifest|icon-maskable.svg|icon-192.png|icon-512.png|icon-maskable-192.png|icon-maskable-512.png|apple-touch-icon.png|og-image.png|vite.svg|200ok-logo.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/((?!assets/|api/|favicon\\.svg|vite\\.svg|og-image\\.png|manifest\\.webmanifest|icon-|apple-touch-icon|200ok-logo\\.svg).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
