VITE_API_URL=http://localhost:4000/api

# Dominio público de la app (Open Graph, canonical — ver index.html). Sin
# definir, el build usa https://rincones.vercel.app. Configurar sólo en
# Vercel (frontend) el día que haya dominio propio; no hace falta en local.
VITE_SITE_URL=

# --- Monitoreo de errores (Sentry, opcional) ---
# Sin VITE_SENTRY_DSN, el monitoreo queda apagado y el paquete de Sentry ni
# siquiera se descarga (ver src/services/errorMonitoring.js). Usá la MISMA
# cuenta/proyecto de Sentry que el backend si querés ver los dos lados
# correlacionados, pero es un proyecto de Sentry aparte (SDK de navegador).
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# --- "Continuar con Google" (opcional) ---
# Sin esto, el botón de Google no se muestra — ver GOOGLE_CLIENT_ID en
# server/.env.example (mismo valor en los dos lados).
VITE_GOOGLE_CLIENT_ID=
