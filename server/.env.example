PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/rincones
# Qué base usar DENTRO del cluster. OBLIGATORIA: el server se niega a arrancar
# sin ella (ver src/config/db.js).
#
#   local       -> test
#   producción  -> rincones
#
# Antes era opcional, y eso era una trampa: sin el dato Mongoose cae a su base
# por defecto, que se llama "test"... el mismo nombre que la base de desarrollo.
# Una variable perdida en un deploy no rompía nada, sólo hacía que los usuarios
# REALES se registraran mezclados con los de prueba, en silencio. Mejor no
# arrancar que entreverar producción con desarrollo.
#
# LAS DOS BASES DEL PROYECTO:
#   rincones  → PRODUCCIÓN. Datos reales. Sólo el deploy la usa.
#   test      → desarrollo y pruebas locales. Es la que va acá.
#
# El ejemplo apunta a `test` A PROPÓSITO. Antes decía `rincones`, y eso es un
# arma cargada: quien clona el repo hace `cp .env.example .env`, arranca el
# server y sin saberlo está escribiendo en la base de producción. El default de
# un archivo de ejemplo tiene que ser el destino inofensivo; producción se pone
# a mano, en el panel del hosting, y una sola vez.
MONGODB_DB_NAME=test
JWT_SECRET=change_this_super_secret
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@rincones.local
ADMIN_PASSWORD=change_this_password
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_VERCEL_PREVIEWS=false

# --- Métricas de uso (opcional) ---
# La sal con la que se hashea la identidad de cada visitante (IP + navegador).
# El hash es lo ÚNICO que se guarda: la IP no toca la base, y sin esta sal no se
# puede volver atrás. Por eso la app no necesita cartel de cookies.
#
# Si lo dejás vacío se usa JWT_SECRET, que funciona pero mezcla dos secretos con
# vidas distintas: el día que rotes el JWT (por seguridad, que es lo correcto)
# todos los visitantes recurrentes van a contarse como nuevos y el gráfico va a
# mostrar un salto que no pasó. Con una sal propia eso no ocurre.
#
# Cambiarla a propósito equivale a "olvidar" quién ya había entrado.
ANALYTICS_SALT=

# Email / SMTP (verificación de cuenta + recuperación de contraseña).
# Si no se completa, en desarrollo el endpoint devuelve el enlace directamente
# (no envía mail). Probá tu config con:  npm run mail:test tu@email.com
#
# Ejemplos de proveedor:
#   Brevo (gratis, recomendado):  host=smtp-relay.brevo.com  port=587  user=<login SMTP>  pass=<SMTP key>
#   Resend:                       host=smtp.resend.com       port=587  user=resend        pass=<API key>
#   Gmail (app password):         host=smtp.gmail.com        port=587  user=<tu@gmail>    pass=<app password 16 díg.>
#
# Evitá Gmail en producción: es una cuenta personal, no un servicio
# transaccional — sin dominio propio con SPF/DKIM, Gmail filtra o directo
# rechaza el envío saliente desde un servidor (Vercel), sobre todo hacia
# cuentas nuevas. Brevo o Resend tienen plan gratis y están pensados para esto.
#
# port 587 = STARTTLS (lo normal) · port 465 = SSL directo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Debe ser un remitente autorizado por tu proveedor (idealmente un dominio verificado).
EMAIL_FROM=Rincones <no-reply@tudominio.com>

# --- "Continuar con Google" (opcional) ---
# Sin esto configurado, el botón de Google simplemente no aparece (ver
# VITE_GOOGLE_CLIENT_ID en client/.env.example) — el registro con
# email+contraseña sigue funcionando igual. Mismo Client ID en los dos lados
# (server lo usa para validar el token, client para pedirlo).
#
# Se crea en https://console.cloud.google.com/apis/credentials como
# "ID de cliente de OAuth" tipo "Aplicación web". El flujo (ver
# client/src/utils/googleOAuth.js) es una REDIRECCIÓN DE PÁGINA COMPLETA, no el
# botón/popup de Google Identity Services — y por eso necesita DOS listas
# cargadas en la consola, no una sola:
#
#   "Orígenes de JavaScript autorizados"  → el origen pelado, sin ruta:
#     http://localhost:5173
#     https://rincones.vercel.app
#     https://www.rincones.vercel.app
#
#   "URIs de redireccionamiento autorizados" → el origen + `/auth/google/callback`
#   EXACTO (esta es la lista que suele faltar, y sin ella Google devuelve
#   "Error 400: redirect_uri_mismatch" — el "bad request" intermitente que
#   depende de desde qué dominio entra cada persona):
#     http://localhost:5173/auth/google/callback
#     https://rincones.vercel.app/auth/google/callback
#     https://www.rincones.vercel.app/auth/google/callback
#
# Cualquier origen nuevo que se sume acá (ver CORS_ALLOWED_ORIGINS arriba, y la
# lista fija en src/config/cors.js) necesita SU callback agregado a la segunda
# lista, o el login con Google va a fallar sólo para quien entre por ese origen.
GOOGLE_CLIENT_ID=

# --- Escaneo de etiquetas con IA (Gemini, opcional pero recomendado) ---
# Key gratis en https://aistudio.google.com (no pide tarjeta).
# Si no se configura, el escaneo cae automáticamente al OCR local (Tesseract).
#
# ⚠️  NO HABILITAR BILLING en el proyecto de Google Cloud de esta key.
#
# El free tier no es "gratis hasta cierto punto y después te cobran": es todo o
# nada. En cuanto se vincula una cuenta de facturación al proyecto, el free tier
# DESAPARECE y se paga desde el primer request.
#
# Mientras el proyecto no tenga facturación es imposible que cobren: al agotarse
# la cuota la API devuelve 429, gemini.service.js pasa al siguiente modelo de la
# cadena y, si se agotan todos, el escaneo cae al OCR local. Nunca hay cargo.
#
# Cómo verificarlo: https://aistudio.google.com/apikey → columna "Plan" debe
# decir "Free". Confirmación extra en console.cloud.google.com → Facturación:
# el proyecto tiene que figurar SIN cuenta de facturación asociada.
#
# La key no tiene plan propio: hereda el del proyecto al que pertenece. Si algún
# día creás una key nueva, fijate en qué proyecto la estás creando.
#
# Cuota del free tier (julio 2026 — Google la cambia sin aviso):
#   flash-lite  15/min   1.000/día
#   flash       10/min     250/día
#   pro          5/min     100/día
# Los límites son POR MODELO, y por eso gemini.service.js encadena varios: al
# agotarse uno sigue con el próximo en vez de quedarse sin escaneo.
GEMINI_API_KEY=
# Modelo preferido (OPCIONAL, y conviene dejarlo vacío).
#
# Vacío = se usa la cadena de gemini.service.js, ordenada por latencia medida y
# con reintento automático cuando un modelo se queda sin cuota. Fijar uno acá lo
# pone PRIMERO siempre, así que si ese se agota se pierde un intento en cada
# llamada. Sólo tiene sentido para forzar un modelo puntual mientras se prueba.
GEMINI_MODEL=

# --- Imágenes (Cloudinary, opcional) ---
# Sin esto, las fotos (vinos, momentos, etiquetas escaneadas, logos de
# anunciantes) se guardan en base64 dentro de Mongo en vez de subirse al CDN:
# la app funciona igual, pero los documentos pesan más y no hay optimización
# ni entrega por CDN. Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Cookies de sesión entre subdominios (opcional) ---
# Sólo hacen falta si el frontend y el backend van a vivir en subdominios
# distintos del MISMO dominio propio (por ejemplo app.tudominio.com y
# api.tudominio.com). Sin dominio propio, dejar vacío: session.service.js ya
# elige un default sensato (`lax` en desarrollo, `none` en producción).
COOKIE_DOMAIN=
COOKIE_SAMESITE=

# --- Monitoreo de errores (Sentry, opcional) ---
# Sin SENTRY_DSN, el monitoreo queda apagado por completo (ver
# src/config/sentry.js): no se instala nada, no se manda nada. Con la DSN
# puesta, cada error 500 y cada excepción no controlada se reporta, siempre
# filtrando antes tokens, cookies y contraseñas.
# DSN gratis en https://sentry.io (plan Developer, 5k eventos/mes sin tarjeta).
SENTRY_DSN=
# Opcional: identifica en qué versión pasó el error. Si el deploy es en
# Vercel, VERCEL_GIT_COMMIT_SHA ya cumple esta función sin configurar nada acá.
SENTRY_RELEASE=
